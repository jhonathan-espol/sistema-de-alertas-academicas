# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# Lo usan tanto Python (ml/) como la aplicación web (web/). El archivo .env NO se sube a GitHub.

# PostgreSQL local (pgAdmin): crea antes la base "db_alertas".
DATABASE_URL=postgresql://postgres:TU_CLAVE_DE_POSTGRES@localhost:5432/db_alertas

# Clave para firmar las sesiones (mínimo 32 caracteres). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Carpeta con los reportes de SIGA y ATENEA (por defecto: ..\REPORTES SIGA & ATENEA)
# REPORTES_DIR=D:\ESPOL\REPORTES SIGA & ATENEA

# 1 = cargar cédula y nombre de los estudiantes en la base (por defecto solo un código seudónimo)
# INCLUIR_IDENTIDAD=0
